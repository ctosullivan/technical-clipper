          "id": "6repr7xrlomgxcoh",
          "language": "typescript",
          "languageEvidence": "class-token",
          "text": "export const routes = [\n  { path: '/', component: Home },\n  { path: '/about', component: About },\n];\n"
        },
        "type": "codeBlock"
      },
      {
        "children": [
          {
            "type": "text",
            "value": "Paths are matched in declaration order; the first match wins."
          }
        ],
        "id": "5s5ng5gdv4peh3et",
        "type": "paragraph"
      },
      {
        "children": [
          {
            "type": "text",
            "value": "Nested routes"
