        "level": 2,
        "type": "heading"
      },
      {
        "children": [
          {
            "type": "text",
            "value": "Child routes render into a parent's "
          },
          {
            "type": "codeSpan",
            "value": "<Outlet />"
          },
          {
            "type": "text",
            "value": ". The steps are:"
